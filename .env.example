# ================================
# EMOOSE Dashboard - Environment Config
# Salin file ini menjadi ".env" lalu isi sesuai kebutuhan
# ================================

# Port dashboard (WAJIB 5135 sesuai SRS/TDD)
PORT=5135

# Session secret (ganti dengan string acak yang panjang untuk produksi)
SESSION_SECRET=emoose-super-secret-change-this

# Kredensial login dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=emoose2026

# Telegram Bot API (opsional, kosongkan jika belum punya bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nama node / kandang default (ditampilkan di peta & dashboard)
NODE_ID=EMOOSE-NODE-01
NODE_LAT=-8.100557
NODE_LNG=112.648576

# ================================
# EMOOSE DEMO SIMULATION MODULE (plug-and-play)
# Fitur "Simulasi Darurat" untuk demo/presentasi/QA -- TIDAK memengaruhi
# data sensor ESP32 asli. Set DEMO_ENABLED=false untuk menonaktifkan
# total (endpoint, tombol, dan panel demo semuanya hilang).
# ================================
DEMO_ENABLED=true
DEMO_MASTER_CODE=emoose2025
